@model CategoryFormViewModel

<input type="hidden" asp-for="EventId" />
<input type="hidden" asp-for="CategoryId" />

<div class="row g-3">
    <div class="col-12">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" maxlength="50" placeholder="e.g. Open, Under 20, Masters 50+" />
        <span asp-validation-for="Name" class="text-danger small"></span>
    </div>
    <div class="col-6">
        <label asp-for="MinAge" class="form-label"></label>
        <input asp-for="MinAge" type="number" min="0" max="120" class="form-control" />
        <span asp-validation-for="MinAge" class="text-danger small"></span>
    </div>
    <div class="col-6">
        <label asp-for="MaxAge" class="form-label"></label>
        <input asp-for="MaxAge" type="number" min="0" max="120" class="form-control" />
        <span asp-validation-for="MaxAge" class="text-danger small"></span>
    </div>
    <div class="col-12">
        <label asp-for="DistanceKm" class="form-label"></label>
        <input asp-for="DistanceKm" type="number" step="0.01" min="0.1" class="form-control" placeholder="Optional, if this category runs a different distance" />
        <span asp-validation-for="DistanceKm" class="text-danger small"></span>
    </div>
</div>
