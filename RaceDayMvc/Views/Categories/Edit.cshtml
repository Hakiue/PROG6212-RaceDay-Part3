@model CategoryFormViewModel
@{
    ViewData["Title"] = "Edit category";
}

<div class="container py-4" style="max-width: 640px;">
    <a class="back-link" asp-action="Index" asp-route-eventId="@Model.EventId"><i class="bi bi-arrow-left"></i> Categories</a>
    <h1 class="rd-heading mt-2 mb-1">Edit category</h1>
    <p class="text-muted mb-4">@ViewData["EventName"]</p>

    <div class="rd-panel p-4">
        <form asp-action="Edit" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
            <partial name="_CategoryForm" model="Model" />
            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-rd">Save changes</button>
                <a class="btn btn-outline-secondary" asp-action="Index" asp-route-eventId="@Model.EventId">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
