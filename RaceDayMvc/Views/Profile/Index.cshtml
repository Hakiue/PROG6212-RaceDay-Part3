@model ProfileViewModel
@{
    ViewData["Title"] = "Profile";
    var fullName = $"{Model.FirstName} {Model.LastName}".Trim();
}

<div class="container py-4">
    <h1 class="rd-heading mb-1">My profile</h1>
    <p class="text-muted mb-4">Keep your details up to date and add a profile picture.</p>

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="rd-panel p-4 text-center">
                @if (!string.IsNullOrEmpty(Model.ProfilePictureUrl))
                {
                    <img class="avatar-lg" src="@Model.ProfilePictureUrl" alt="Your profile picture" />
                }
                else
                {
                    <div class="avatar-lg avatar-initials">@ViewHelpers.Initials(fullName)</div>
                }
                <h2 class="h5 mt-3 mb-0">@fullName</h2>
                <p class="text-muted small">@Model.Email</p>

                <form asp-action="UploadPicture" method="post" enctype="multipart/form-data" class="text-start mt-3">
                    <label class="form-label small" for="picture">Profile picture (JPEG, PNG, WebP or GIF, up to 5 MB)</label>
                    <input id="picture" name="picture" type="file" class="form-control" accept="image/jpeg,image/png,image/webp,image/gif" required />
                    <button type="submit" class="btn btn-outline-secondary w-100 mt-2"><i class="bi bi-upload me-1"></i>Upload picture</button>
                </form>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="rd-panel p-4">
                <h2 class="h5 mb-3">Personal details</h2>
                <form asp-action="Update" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <label asp-for="FirstName" class="form-label"></label>
                            <input asp-for="FirstName" class="form-control" />
                            <span asp-validation-for="FirstName" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="LastName" class="form-label"></label>
                            <input asp-for="LastName" class="form-control" />
                            <span asp-validation-for="LastName" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="email">Email</label>
                            <input id="email" class="form-control" value="@Model.Email" disabled />
                            <div class="form-text">Your email is your login, so it can't be changed here.</div>
                        </div>
                        <div class="col-12">
                            <label asp-for="PhoneNumber" class="form-label"></label>
                            <input asp-for="PhoneNumber" class="form-control" />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-rd mt-4">Save changes</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
