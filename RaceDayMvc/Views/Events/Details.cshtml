@model EventDetailsViewModel
@{
    var ev = Model.Event;
    ViewData["Title"] = ev.Name;

    var role = Context.Session.GetString(SessionKeys.Role);
    var loggedIn = Context.Session.GetInt32(SessionKeys.UserId) is not null;
    var isPast = ev.EventDate.Date < DateTime.UtcNow.Date;
    var returnUrl = $"/Events/Details/{ev.EventId}";
}

<div class="container py-4">
    <a asp-controller="Home" asp-action="Index" class="back-link"><i class="bi bi-arrow-left"></i> All events</a>

    <div class="row g-4 mt-1">
        <div class="col-lg-8">
            <div class="detail-banner @ViewHelpers.TypeClass(ev.EventTypeName)">
                @if (!string.IsNullOrEmpty(ev.BannerImageUrl))
                {
                    <img src="@ev.BannerImageUrl" alt="Banner for @ev.Name" />
                }
                else
                {
                    <i class="bi @ViewHelpers.TypeIcon(ev.EventTypeName) banner-icon"></i>
                }
                <span class="type-chip"><i class="bi @ViewHelpers.TypeIcon(ev.EventTypeName)"></i> @ev.EventTypeName</span>
            </div>

            <h1 class="rd-heading display-6 mt-4 mb-3">@ev.Name</h1>

            <ul class="meta-list meta-list-lg">
                <li><i class="bi bi-calendar-event"></i> @ViewHelpers.EventDate(ev.EventDate)</li>
                <li><i class="bi bi-geo-alt-fill"></i> @ev.Location</li>
                <li><i class="bi bi-signpost-split-fill"></i> @ev.DistanceKm.ToString("0.##") km</li>
                <li><i class="bi bi-people-fill"></i> @ev.EnrolmentCount entered</li>
            </ul>

            @if (!string.IsNullOrWhiteSpace(ev.Description))
            {
                <h2 class="rd-heading h4 mt-4">About this event</h2>
                <p class="event-description">@ev.Description</p>
            }

            <h2 class="rd-heading h4 mt-4">Categories</h2>
            @if (Model.Categories.Any())
            {
                <div class="table-responsive">
                    <table class="table rd-table align-middle">
                        <thead><tr><th>Category</th><th>Ages</th><th>Distance</th></tr></thead>
                        <tbody>
                            @foreach (var c in Model.Categories)
                            {
                                <tr>
                                    <td class="fw-semibold">@c.Name</td>
                                    <td>@ViewHelpers.CategoryAges(c)</td>
                                    <td>@(c.DistanceKm is null ? "—" : c.DistanceKm.Value.ToString("0.##") + " km")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted">The organiser hasn't added any categories yet.</p>
            }
        </div>

        <div class="col-lg-4">
            <div class="enter-card">
                <h2 class="rd-heading h4 mb-3">Enter this event</h2>

                @if (isPast)
                {
                    <div class="alert alert-secondary mb-0"><i class="bi bi-flag-fill me-1"></i> This event has already taken place.</div>
                }
                else if (role == Roles.Participant)
                {
                    if (Model.ExistingEnrolment is not null)
                    {
                        var existing = Model.ExistingEnrolment;
                        <p class="mb-2">You're entered in <strong>@existing.CategoryName</strong>.</p>
                        <span class="status-badge @ViewHelpers.StatusClass(existing.Status)"><i class="bi @ViewHelpers.StatusIcon(existing.Status)"></i> @existing.Status</span>
                        <a class="btn btn-outline-secondary w-100 mt-3" asp-controller="MyEnrolments" asp-action="Index">See my entries</a>
                    }
                    else if (Model.Categories.Any())
                    {
                        <form asp-controller="Events" asp-action="Enrol" method="post">
                            <input type="hidden" name="eventId" value="@ev.EventId" />
                            <p class="text-muted small">Choose your category:</p>
                            @foreach (var c in Model.Categories)
                            {
                                <label class="category-option">
                                    <input type="radio" name="categoryId" value="@c.CategoryId" required />
                                    <span class="category-card">
                                        <strong>@c.Name</strong>
                                        <small>@ViewHelpers.CategoryAges(c)@(c.DistanceKm is null ? "" : " · " + c.DistanceKm.Value.ToString("0.##") + " km")</small>
                                    </span>
                                </label>
                            }
                            <button type="submit" class="btn btn-rd btn-lg w-100 mt-3">Enter now</button>
                        </form>
                    }
                    else
                    {
                        <p class="text-muted mb-0">Entries open once the organiser adds categories.</p>
                    }
                }
                else if (!loggedIn)
                {
                    <p class="text-muted">Log in to enter this event.</p>
                    <a class="btn btn-rd w-100 mb-2" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@returnUrl">Log in</a>
                    <a class="btn btn-outline-secondary w-100" asp-controller="Account" asp-action="Register">Create an account</a>
                }
                else
                {
                    <div class="alert alert-info mb-0">Organiser accounts can't enter events. Log in with a Participant account to enter.</div>
                }
            </div>
        </div>
    </div>
</div>
