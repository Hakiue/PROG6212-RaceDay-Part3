@model EventFormViewModel
@{
    ViewData["Title"] = Model.IsEdit ? "Edit event" : "Create event";
    var dateValue = Model.EventDate?.ToString("yyyy-MM-ddTHH:mm", System.Globalization.CultureInfo.InvariantCulture);
}

<div class="container py-4">
    <a class="back-link" asp-action="Index"><i class="bi bi-arrow-left"></i> My events</a>
    <h1 class="rd-heading mt-2 mb-1">@(Model.IsEdit ? "Edit event" : "Create event")</h1>
    <p class="text-muted mb-4">@(Model.IsEdit ? "Update the details below. Participants see the changes straight away." : "Fill in the details. You'll add categories on the next page.")</p>

    <form method="post" enctype="multipart/form-data" novalidate
          asp-action="@(Model.IsEdit ? "Edit" : "Create")" asp-route-id="@Model.EventId">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

        <div class="row g-4">
            <div class="col-lg-8">
                <div class="rd-panel p-4">
                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="Name" class="form-label"></label>
                            <input asp-for="Name" class="form-control" maxlength="100" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Description" class="form-label"></label>
                            <textarea asp-for="Description" class="form-control" rows="5"></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="EventDate" class="form-label"></label>
                            <input id="EventDate" name="EventDate" type="datetime-local" class="form-control" value="@dateValue" />
                            <span asp-validation-for="EventDate" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Location" class="form-label"></label>
                            <input asp-for="Location" class="form-control" maxlength="150" />
                            <span asp-validation-for="Location" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="DistanceKm" class="form-label"></label>
                            <input asp-for="DistanceKm" type="number" step="0.01" min="0.1" class="form-control" />
                            <span asp-validation-for="DistanceKm" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="EventTypeId" class="form-label"></label>
                            <select asp-for="EventTypeId" class="form-select">
                                <option value="0">Choose a type…</option>
                                @foreach (var t in Model.EventTypes)
                                {
                                    <option value="@t.EventTypeId">@t.TypeName</option>
                                }
                            </select>
                            <span asp-validation-for="EventTypeId" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="rd-panel p-4">
                    <h2 class="h5 mb-3">Banner image</h2>
                    <div id="bannerPreview" class="banner-preview mb-3">
                        @if (!string.IsNullOrEmpty(Model.BannerImageUrl))
                        {
                            <img src="@Model.BannerImageUrl" alt="Current banner" />
                        }
                        else
                        {
                            <span class="text-muted small"><i class="bi bi-image me-1"></i>No banner yet</span>
                        }
                    </div>
                    <label class="form-label" for="banner">@(Model.IsEdit ? "Replace banner (optional)" : "Upload a banner (optional)")</label>
                    <input id="banner" name="banner" type="file" class="form-control" accept="image/jpeg,image/png,image/webp,image/gif" />
                    <div class="form-text">JPEG, PNG, WebP or GIF, up to 5 MB. It's sent to the RaceDay API, which stores it in Azure Blob Storage.</div>
                </div>

                <div class="d-grid gap-2 mt-3">
                    <button type="submit" class="btn btn-rd btn-lg">@(Model.IsEdit ? "Save changes" : "Create event")</button>
                    <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Show a preview of the chosen banner before it is uploaded
        document.getElementById('banner').addEventListener('change', function (e) {
            var file = e.target.files && e.target.files[0];
            var box = document.getElementById('bannerPreview');
            if (!file || !file.type.startsWith('image/')) { return; }
            var reader = new FileReader();
            reader.onload = function (ev) {
                box.innerHTML = '';
                var img = document.createElement('img');
                img.src = ev.target.result;
                img.alt = 'Selected banner preview';
                box.appendChild(img);
            };
            reader.readAsDataURL(file);
        });
    </script>
}
